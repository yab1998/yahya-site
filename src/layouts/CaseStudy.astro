---
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props { entry: CollectionEntry<'work'>; next?: CollectionEntry<'work'> }
const { entry, next } = Astro.props;
const d = entry.data;
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const facts = [['Role', d.role], ['Team', d.team], ['Timeline', d.timeline], ['Tools', d.tools]].filter(([, v]) => v);
---
<BaseLayout title={`${d.title} | yahya abdul-basser.`} description={d.description} image={og.src}>
  <article class="cs">
    <header class="wrap top">
      <a class="back mono" href="/#work">← All work</a>
      <p class="k">{d.lane}</p>
      <h1>{d.title}</h1>
      <p class="sum">{d.summary}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt class="k">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </header>
    <div class="hero grain">
      <Picture src={d.cover} alt={d.coverAlt} formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="body wrap">
      <slot />
    </div>
    {next && (
      <a class="next" href={`/work/${next.id}/`}>
        <span class="k">Next project</span>
        <b>{next.data.title} →</b>
      </a>
    )}
  </article>
</BaseLayout>

<style>
  .top{padding-block:56px 40px;max-width:1100px}
  .back{font-size:13px;display:inline-block;margin-bottom:28px;text-decoration:underline;text-underline-offset:4px}
  h1{margin:8px 0 16px;font-size:clamp(44px,7vw,96px);font-weight:900;line-height:.92;letter-spacing:-.04em}
  .sum{font-size:var(--fs-lead);line-height:1.4;margin:0 0 32px;font-weight:500}
  .facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin:0;border-top:3px solid var(--ink);padding-top:20px}
  .facts dd{margin:4px 0 0;font-weight:600}
  .hero{border-block:3px solid var(--ink);max-height:80vh}
  .hero :global(img){width:100%;max-height:80vh;object-fit:cover;object-position:top}
  .body{max-width:calc(var(--measure) + var(--gut) * 2);margin:0 auto;padding-block:64px 80px}
  .body :global(h2){font-size:clamp(28px,3vw,40px);margin:48px 0 12px;letter-spacing:-.025em}
  .body :global(p){margin:0 0 16px}
  .body :global(img){margin:32px calc(50% - 50vw);width:100vw;max-width:100vw;border-block:3px solid var(--ink)}
  .body :global(.flow){list-style:none;padding:0;margin:24px 0;display:grid;gap:10px;counter-reset:f}
  .body :global(.flow li){counter-increment:f;display:grid;grid-template-columns:44px 1fr;gap:2px 14px;align-items:start;padding:14px;border:2px solid var(--ink);border-radius:12px;background:var(--paper)}
  .body :global(.flow li)::before{content:counter(f);grid-row:span 2;width:36px;height:36px;border-radius:50%;background:var(--green);color:var(--white);display:grid;place-items:center;font-weight:900}
  .body :global(.flow span){color:var(--muted);font-size:15px}
  .body :global(.proto){margin:24px calc(50% - min(50vw, 640px));border:3px solid var(--ink);border-radius:12px;overflow:hidden;background:#EEF3F2}
  .body :global(.proto iframe){display:block;width:100%;height:min(80vh,760px);border:0}
  .body :global(.protonote){font-size:14px}
  .body :global(.protonote a){text-decoration:underline;text-underline-offset:3px;font-weight:700}
  .next{display:flex;flex-direction:column;gap:6px;background:var(--night);color:var(--day);padding:48px var(--gut)}
  .next .k{color:#c9c3b6}
  .next b{font-size:clamp(28px,4vw,56px);font-weight:900;letter-spacing:-.03em}
  .next:hover b{color:var(--yellow)}
</style>
