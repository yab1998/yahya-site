---
// Album art collection as a record crate: covers lean back in a row, pull up on hover with
// their vinyl sliding out, open in the lightbox on click. Filter: mine / for other artists.
import { Picture } from 'astro:assets';
import { img, url } from '../lib/images';
import site from '../data/site.json';

const others = ['Bye Bye Savannah', 'Life Lion', "valentine's day", 'SANDSTORM'];
const skip = ["remember us (breonna's song)"]; // commissioned art by Omar Din, not Yahya's
const covers = await Promise.all(site.design
  .filter((w) => w.tags.includes('artwork') && (w as any).label !== 'Motion' && !skip.includes(w.title))
  .map(async (w) => {
    const items = await Promise.all(w.images.map(async (p, k) => ({ src: await url(p), alt: w.alt[k] ?? w.title })));
    return { title: w.title, first: w.images[0], n: w.images.length, who: others.includes(w.title) ? 'others' : 'mine',
      lb: JSON.stringify({ items, title: w.title, kind: others.includes(w.title) ? 'Cover · for another artist' : 'Cover', blurb: w.blurb, credit: w.credit }) };
  }));
const hues = ['#E63946', '#7B2CBF', '#F4A261', '#2A9D8F', '#264653', '#E9C46A', '#118AB2'];
---
<section class="crate-wrap" aria-labelledby="crateTitle">
  <div class="crate-head">
    <h2 id="crateTitle">The crate <span>{covers.length} covers</span></h2>
    <div class="crate-tabs" role="group" aria-label="Filter covers">
      <button type="button" data-w="all" aria-pressed="true">All</button>
      <button type="button" data-w="mine" aria-pressed="false">My releases</button>
      <button type="button" data-w="others" aria-pressed="false">For other artists</button>
    </div>
  </div>
  <p class="crate-hint mono" aria-hidden="true">← drag or scroll to dig through · click to open →</p>
  <ul class="crate" tabindex="0" aria-label="Album covers, scrollable">
    {covers.map((c, i) => (
      <li class="rec" data-who={c.who} style={`--h:${hues[i % hues.length]};--i:${i}`}>
        <button type="button" data-lb={c.lb} aria-label={`Open ${c.title}`}>
          <span class="disc" aria-hidden="true"><i></i></span>
          <span class="sleeve"><Picture src={img(c.first)} alt="" formats={['avif', 'webp']} widths={[300, 560]} sizes="(max-width: 760px) 60vw, 280px" loading="eager" /></span>
        </button>
        <span class="lbl"><b>{c.title}</b>{c.n > 1 && <em>{c.n} pieces</em>}{c.who === 'others' && <em>for another artist</em>}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>('.crate');
  if (wrap) {
    let down = false, x0 = 0, s0 = 0, moved = 0;
    wrap.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = 0; x0 = e.clientX; s0 = wrap.scrollLeft; wrap.classList.add('drag'); });
    addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - x0; moved = Math.max(moved, Math.abs(dx)); wrap.scrollLeft = s0 - dx; });
    addEventListener('pointerup', () => { down = false; wrap.classList.remove('drag'); });
    wrap.addEventListener('click', (e) => { if (moved > 6) { e.stopPropagation(); e.preventDefault(); moved = 0; } }, true);
    wrap.addEventListener('wheel', (e) => { if (Math.abs(e.deltaY) > Math.abs(e.deltaX) && wrap.scrollWidth > wrap.clientWidth) { const max = wrap.scrollWidth - wrap.clientWidth; if ((e.deltaY > 0 && wrap.scrollLeft < max) || (e.deltaY < 0 && wrap.scrollLeft > 0)) { e.preventDefault(); wrap.scrollLeft += e.deltaY; } } }, { passive: false });
  }
  document.querySelectorAll<HTMLButtonElement>('.crate-tabs button').forEach((b, _, all) => b.addEventListener('click', () => {
    all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.rec').forEach((r) => { r.hidden = b.dataset.w !== 'all' && r.dataset.who !== b.dataset.w; });
    wrap?.scrollTo({ left: 0, behavior: 'smooth' });
  }));
</script>

<style>
  .crate-wrap{width:100vw;margin:0 0 64px calc(50% - 50vw);padding:56px 0 24px;background:var(--ink);color:var(--cream);border-block:3px solid var(--ink)}
  .crate-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:18px;padding:0 clamp(16px,4vw,56px)}
  .crate-head h2{margin:0;font-size:clamp(40px,6vw,84px);font-weight:900;letter-spacing:-.04em;line-height:.9;color:var(--cream)}
  .crate-head h2 span{font-family:var(--pixel);font-size:16px;font-weight:400;letter-spacing:0;vertical-align:middle;margin-left:10px;color:#f5c518}
  .crate-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .crate-tabs button{min-height:42px;padding:0 18px;border-radius:999px;border:2px solid var(--cream);background:transparent;color:var(--cream);font-weight:800;cursor:pointer}
  .crate-tabs button[aria-pressed=true]{background:var(--cream);color:var(--ink)}
  .crate-hint{font-size:12px;opacity:.6;padding:18px clamp(16px,4vw,56px) 0;margin:0}
  .crate{list-style:none;margin:0;padding:70px clamp(16px,4vw,56px) 40px;display:flex;gap:clamp(10px,1.4vw,22px);overflow-x:auto;scroll-snap-type:x proximity;cursor:grab;scrollbar-width:thin;scrollbar-color:var(--cream) transparent}
  .crate.drag{cursor:grabbing;scroll-snap-type:none}.crate.drag *{pointer-events:none}
  .crate:focus-visible{outline:3px solid #f5c518;outline-offset:-3px}
  .rec{flex:0 0 clamp(190px,22vw,290px);scroll-snap-align:start;display:flex;flex-direction:column;gap:14px}
  .rec[hidden]{display:none}
  .rec{position:relative}.rec:hover,.rec:focus-within{z-index:5}
  .rec button{position:relative;display:block;width:100%;aspect-ratio:1;padding:0;border:0;background:none;cursor:pointer;isolation:isolate}
  .sleeve{position:absolute;inset:0;border-radius:6px;overflow:hidden;z-index:2;box-shadow:0 18px 30px -12px rgba(0,0,0,.7),0 0 0 2px rgba(255,255,255,.08);transform:perspective(900px) rotateY(-14deg) rotateX(6deg);transform-origin:left center;transition:transform .55s cubic-bezier(.2,.8,.2,1),box-shadow .4s}
  .sleeve :global(picture),.sleeve :global(img){width:100%!important;max-width:100%!important;height:100%;margin:0!important;border:0!important;object-fit:cover;display:block}
  .disc{position:absolute;inset:4%;border-radius:50%;z-index:1;background:radial-gradient(circle,var(--h) 0 15%,#0b0b0b 15.5% 17%,#1a1a1a 17.5%),repeating-radial-gradient(circle,#161616 0 2px,#222 2px 3px);transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .disc i{position:absolute;left:50%;top:50%;width:5%;height:5%;border-radius:50%;background:var(--ink);translate:-50% -50%}
  .rec button:hover .sleeve,.rec button:focus-visible .sleeve{transform:perspective(900px) translateY(-34px) scale(1.04);box-shadow:0 34px 50px -16px rgba(0,0,0,.85)}
  .rec button:hover .disc,.rec button:focus-visible .disc{transform:translate(42%,-34px) rotate(200deg)}
  .rec button:focus-visible{outline:none}.rec button:focus-visible .sleeve{outline:3px solid #f5c518}
  .lbl{display:flex;flex-direction:column;gap:2px;transition:transform .5s}
  .lbl b{font-size:16px;line-height:1.2}.lbl em{font-style:normal;font-family:var(--pixel);font-size:12px;color:#f5c518}
  .rec:hover .lbl{transform:translateY(-8px)}
  @media (prefers-reduced-motion:reduce){.sleeve,.disc,.lbl{transition:none}.rec button:hover .disc{transform:translateX(30%)}}
</style>
