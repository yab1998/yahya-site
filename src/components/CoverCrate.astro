---
// Album art as a record crate. Hover: cover straightens, vinyl slides out, alternates cycle.
// Click: the record zooms up to fill the screen with its disc sliding out (custom viewer).
import { Picture } from 'astro:assets';
import { img, url } from '../lib/images';
import covers from '../data/covers.json';

const data = await Promise.all(covers.map(async (c) => ({ ...c, who: c.for === 'Me' ? 'mine' : 'others', big: await Promise.all(c.images.map((p) => url(p, 1400))) })));
const hues = ['#E63946', '#7B2CBF', '#F4A261', '#2A9D8F', '#264653', '#E9C46A', '#118AB2'];
---
<section class="crate-wrap" aria-labelledby="crateTitle">
  <div class="crate-head">
    <h2 id="crateTitle">The crate <span>{data.length} covers</span></h2>
    <div class="crate-tabs" role="group" aria-label="Filter covers">
      <button type="button" data-w="all" aria-pressed="true">All</button>
      <button type="button" data-w="mine" aria-pressed="false">My releases</button>
      <button type="button" data-w="others" aria-pressed="false">For other artists</button>
    </div>
  </div>
  <p class="crate-hint mono" aria-hidden="true">← drag or scroll to dig through · click a record to pull it out →</p>
  <ul class="crate" tabindex="0" aria-label="Album covers, scrollable">
    {data.map((c, i) => (
      <li class="rec" data-who={c.who} data-i={i} style={`--h:${hues[i % hues.length]}`}>
        <button type="button" class="pull" aria-label={`Open ${c.title}`} aria-haspopup="dialog">
          <span class="disc" aria-hidden="true"><i></i></span>
          <span class="sleeve">
            {c.images.map((p, k) => <span class:list={['alt', k === 0 && 'on']}><Picture src={img(p)} alt="" formats={['avif', 'webp']} widths={[300, 560]} sizes="(max-width: 760px) 60vw, 280px" loading="eager" /></span>)}
            {c.images.length > 1 && <span class="count">{c.images.length}</span>}
          </span>
        </button>
        <span class="lbl"><b>{c.title}</b><span>{c.project}</span><em>for {c.for === 'Me' ? 'me' : c.for}</em></span>
      </li>
    ))}
  </ul>
</section>

<dialog class="spin" aria-labelledby="spinTitle">
  <button type="button" class="sx" aria-label="Close">✕</button>
  <div class="stage">
    <div class="vinyl" aria-hidden="true"><i></i></div>
    <div class="art"><img alt="" /></div>
  </div>
  <div class="meta">
    <p class="k mono" id="spinProj"></p>
    <h3 id="spinTitle"></h3>
    <p class="for mono" id="spinFor"></p>
    <p id="spinBlurb"></p>
    <div class="thumbs" id="spinThumbs"></div>
    <div class="nav"><button type="button" class="pv" aria-label="Previous record">←</button><button type="button" class="nx" aria-label="Next record">→</button></div>
  </div>
</dialog>

<script is:inline define:vars={{ data }}>
  window.__crate = data;
</script>
<script>
  type C = { title: string; project: string; for: string; blurb: string; big: string[]; who: string };
  const data: C[] = (window as any).__crate;
  const wrap = document.querySelector<HTMLElement>('.crate')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // drag + wheel scrolling
  let down = false, x0 = 0, s0 = 0, moved = 0;
  wrap.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = 0; x0 = e.clientX; s0 = wrap.scrollLeft; });
  addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - x0; moved = Math.max(moved, Math.abs(dx)); if (moved > 6) wrap.classList.add('drag'); wrap.scrollLeft = s0 - dx; });
  addEventListener('pointerup', () => { down = false; setTimeout(() => wrap.classList.remove('drag'), 0); });
  wrap.addEventListener('wheel', (e) => { if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { const max = wrap.scrollWidth - wrap.clientWidth; if ((e.deltaY > 0 && wrap.scrollLeft < max - 1) || (e.deltaY < 0 && wrap.scrollLeft > 0)) { e.preventDefault(); wrap.scrollLeft += e.deltaY; } } }, { passive: false });

  // filters
  document.querySelectorAll<HTMLButtonElement>('.crate-tabs button').forEach((b, _, all) => b.addEventListener('click', () => {
    all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.rec').forEach((r) => { r.hidden = b.dataset.w !== 'all' && r.dataset.who !== b.dataset.w; });
    wrap.scrollTo({ left: 0, behavior: 'smooth' });
  }));

  // hover: cycle alternate covers
  document.querySelectorAll<HTMLElement>('.rec').forEach((r) => {
    const alts = r.querySelectorAll<HTMLElement>('.alt'); if (alts.length < 2 || reduce) return;
    let t = 0, k = 0;
    const show = (n: number) => alts.forEach((a, j) => a.classList.toggle('on', j === n));
    r.addEventListener('pointerenter', () => { clearInterval(t); t = window.setInterval(() => { k = (k + 1) % alts.length; show(k); }, 900); });
    r.addEventListener('pointerleave', () => { clearInterval(t); k = 0; show(0); });
  });

  // zoom viewer
  const dlg = document.querySelector<HTMLDialogElement>('dialog.spin')!;
  const art = dlg.querySelector<HTMLElement>('.art')!, im = art.querySelector('img')!, vinyl = dlg.querySelector<HTMLElement>('.vinyl')!;
  const $ = (id: string) => document.getElementById(id)!;
  let cur = 0, alt = 0, opener: HTMLElement | null = null;
  const visible = () => [...document.querySelectorAll<HTMLElement>('.rec:not([hidden])')].map((r) => Number(r.dataset.i));
  function fill() {
    const c = data[cur];
    im.src = c.big[alt]; im.alt = `${c.title} cover`;
    $('spinProj').textContent = c.project; $('spinTitle').textContent = c.title;
    $('spinFor').textContent = `for ${c.for === 'Me' ? 'me' : c.for}`; $('spinBlurb').textContent = c.blurb || '';
    const th = $('spinThumbs'); th.replaceChildren();
    if (c.big.length > 1) c.big.forEach((s, k) => { const b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', `Version ${k + 1} of ${c.big.length}`); b.toggleAttribute('aria-current', k === alt); const t = new Image(); t.src = s; t.alt = ''; b.append(t); b.onclick = () => { alt = k; fill(); }; th.append(b); });
    vinyl.style.setProperty('--h', getComputedStyle(document.querySelector<HTMLElement>(`.rec[data-i="${cur}"]`)!).getPropertyValue('--h'));
  }
  function slideOut() { if (reduce) { dlg.classList.add('out'); return; } dlg.classList.remove('out'); void vinyl.offsetWidth; requestAnimationFrame(() => dlg.classList.add('out')); }
  function open(i: number, from: HTMLElement) {
    cur = i; alt = 0; opener = from; fill(); dlg.showModal();
    const sleeve = from.querySelector<HTMLElement>('.sleeve')!;
    if (!reduce) {
      const a = sleeve.getBoundingClientRect(), b = art.getBoundingClientRect();
      art.animate([{ transform: `translate(${a.left - b.left}px,${a.top - b.top}px) scale(${a.width / b.width})` }, { transform: 'none' }], { duration: 520, easing: 'cubic-bezier(.2,.8,.2,1)' });
    }
    setTimeout(slideOut, reduce ? 0 : 380);
  }
  function step(d: number) { const v = visible(); const p = v.indexOf(cur); cur = v[(p + d + v.length) % v.length]; alt = 0; fill(); slideOut(); }
  wrap.addEventListener('click', (e) => {
    if (wrap.classList.contains('drag')) return;
    const b = (e.target as HTMLElement).closest<HTMLElement>('.pull'); if (!b) return;
    open(Number(b.closest<HTMLElement>('.rec')!.dataset.i), b);
  });
  dlg.querySelector('.sx')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.pv')!.addEventListener('click', () => step(-1));
  dlg.querySelector('.nx')!.addEventListener('click', () => step(1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  dlg.addEventListener('close', () => { dlg.classList.remove('out'); opener?.focus(); });
</script>

<style>
  .crate-wrap{width:100vw;margin:0 0 64px calc(50% - 50vw);padding:56px 0 24px;background:var(--ink);color:var(--cream);border-block:3px solid var(--ink)}
  .crate-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:18px;padding:0 clamp(16px,4vw,56px)}
  .crate-head h2{margin:0;font-size:clamp(40px,6vw,84px);font-weight:900;letter-spacing:-.04em;line-height:.9;color:var(--cream)}
  .crate-head h2 span{font-family:var(--pixel);font-size:16px;font-weight:400;letter-spacing:0;vertical-align:middle;margin-left:10px;color:#f5c518}
  .crate-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .crate-tabs button{min-height:42px;padding:0 18px;border-radius:999px;border:2px solid var(--cream);background:transparent;color:var(--cream);font-weight:800;cursor:pointer}
  .crate-tabs button[aria-pressed=true]{background:var(--cream);color:var(--ink)}
  .crate-hint{font-size:12px;opacity:.6;padding:18px clamp(16px,4vw,56px) 0;margin:0}
  .crate{list-style:none;margin:0;padding:70px clamp(16px,4vw,56px) 40px;display:flex;gap:clamp(10px,1.4vw,22px);overflow-x:auto;scroll-snap-type:x proximity;cursor:grab;scrollbar-width:thin;scrollbar-color:var(--cream) transparent}
  .crate.drag{cursor:grabbing;scroll-snap-type:none}
  .crate:focus-visible{outline:3px solid #f5c518;outline-offset:-3px}
  .rec{position:relative;flex:0 0 clamp(190px,22vw,290px);scroll-snap-align:start;display:flex;flex-direction:column;gap:14px}
  .rec:hover,.rec:focus-within{z-index:5}
  .rec[hidden]{display:none}
  .pull{position:relative;display:block;width:100%;aspect-ratio:1;padding:0;border:0;background:none;cursor:pointer;isolation:isolate}
  .sleeve{position:absolute;inset:0;border-radius:6px;overflow:hidden;z-index:2;background:#222;box-shadow:0 18px 30px -12px rgba(0,0,0,.7),0 0 0 2px rgba(255,255,255,.08);transform:perspective(900px) rotateY(-14deg) rotateX(6deg);transform-origin:left center;transition:transform .55s cubic-bezier(.2,.8,.2,1),box-shadow .4s}
  .alt{position:absolute;inset:0;opacity:0;transition:opacity .45s}.alt.on{opacity:1}
  .sleeve :global(picture),.sleeve :global(img){width:100%!important;max-width:100%!important;height:100%;margin:0!important;border:0!important;object-fit:cover;display:block}
  .count{position:absolute;right:8px;top:8px;z-index:3;font-family:var(--pixel);font-size:12px;background:var(--cream);color:var(--ink);border-radius:999px;padding:1px 8px}
  .disc{position:absolute;inset:4%;border-radius:50%;z-index:1;background:radial-gradient(circle,var(--h) 0 15%,#0b0b0b 15.5% 17%,transparent 17.5%),repeating-radial-gradient(circle,#161616 0 2px,#222 2px 3px);transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .disc i{position:absolute;left:50%;top:50%;width:5%;height:5%;border-radius:50%;background:var(--ink);translate:-50% -50%}
  .pull:hover .sleeve,.pull:focus-visible .sleeve{transform:perspective(900px) translateY(-34px) scale(1.04);box-shadow:0 34px 50px -16px rgba(0,0,0,.85)}
  .pull:hover .disc,.pull:focus-visible .disc{transform:translate(42%,-34px) rotate(200deg)}
  .pull:focus-visible{outline:none}.pull:focus-visible .sleeve{outline:3px solid #f5c518}
  .lbl{display:flex;flex-direction:column;gap:2px;transition:transform .5s;font-size:13px}
  .lbl b{font-size:16px;line-height:1.2}.lbl span{opacity:.75}.lbl em{font-style:normal;font-family:var(--pixel);font-size:12px;color:#f5c518}
  .rec:hover .lbl{transform:translateY(-8px)}

  .spin{border:0;padding:0;margin:auto;width:min(1200px,94vw);max-height:94vh;background:transparent;color:var(--cream);overflow:visible}
  .spin::backdrop{background:rgba(10,10,10,.92);backdrop-filter:blur(6px)}
  .spin[open]{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,1fr);gap:clamp(24px,4vw,56px);align-items:center}
  .stage{position:relative;aspect-ratio:1;width:min(70%,78vh)}
  .art{position:absolute;inset:0;z-index:2;border-radius:8px;overflow:hidden;box-shadow:0 40px 80px -20px rgba(0,0,0,.9)}
  .art img{width:100%!important;max-width:100%!important;height:100%;margin:0!important;border:0!important;object-fit:cover;display:block}
  .vinyl{position:absolute;inset:3%;border-radius:50%;z-index:1;--h:#E63946;background:radial-gradient(circle,var(--h) 0 15%,#0b0b0b 15.5% 17%,transparent 17.5%),repeating-radial-gradient(circle,#141414 0 2px,#202020 2px 3px);box-shadow:0 20px 50px rgba(0,0,0,.6),inset 0 0 0 2px #333,inset 0 0 40px rgba(255,255,255,.06);transition:transform .9s cubic-bezier(.2,.8,.2,1)}
  .vinyl i{position:absolute;left:50%;top:50%;width:4%;height:4%;border-radius:50%;background:#0b0b0b;translate:-50% -50%}
  .spin.out .vinyl{transform:translateX(46%);animation:turn 3.2s linear .9s infinite}
  @keyframes turn{from{transform:translateX(46%) rotate(0)}to{transform:translateX(46%) rotate(360deg)}}
  .meta{display:flex;flex-direction:column;gap:12px;padding-left:clamp(0px,6vw,90px)}
  .meta .k{margin:0;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#f5c518}
  .meta h3{margin:0;font-size:clamp(34px,4vw,60px);font-weight:900;letter-spacing:-.03em;line-height:.95}
  .meta .for{margin:0;font-size:13px;opacity:.75}.meta p{margin:0;line-height:1.55;max-width:36ch}
  .thumbs{display:flex;gap:8px;flex-wrap:wrap}.thumbs :global(button){width:56px;height:56px;padding:0;border:2px solid var(--cream);border-radius:6px;overflow:hidden;opacity:.5;cursor:pointer;background:none}.thumbs :global(button[aria-current]){opacity:1;outline:2px solid #f5c518}.thumbs :global(img){width:100%!important;max-width:100%!important;height:100%;margin:0!important;border:0!important;object-fit:cover}
  .nav{display:flex;gap:10px;margin-top:8px}.nav button,.sx{width:48px;height:48px;border-radius:50%;border:2px solid var(--cream);background:transparent;color:var(--cream);font-size:20px;cursor:pointer}
  .nav button:hover,.sx:hover{background:var(--cream);color:var(--ink)}
  .sx{position:fixed;top:18px;right:18px;z-index:5}
  @media (max-width:820px){.spin[open]{grid-template-columns:1fr;overflow:auto}.stage{width:78%;margin:0}.meta{padding:0 0 24px}.spin.out .vinyl{transform:translateX(24%)}@keyframes turn{from{transform:translateX(24%) rotate(0)}to{transform:translateX(24%) rotate(360deg)}}}
  @media (prefers-reduced-motion:reduce){.sleeve,.disc,.lbl,.alt,.vinyl{transition:none}.spin.out .vinyl{animation:none}}
</style>
