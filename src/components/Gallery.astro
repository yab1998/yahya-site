---
// The Design section: cover art / illustration grid with filters + the curated photo wall.
import { Picture } from 'astro:assets';
import { img, url } from '../lib/images';
import site from '../data/site.json';
import laurelCover from '../assets/case/laurel-home.jpg';
import commissionCover from '../assets/case/commission-dash.jpg';

const tiles = await Promise.all(site.design.map(async (w) => {
  const items = await Promise.all(w.images.map(async (p, k) => ({ src: await url(p), alt: w.alt[k] ?? w.title })));
  if (w.video) items.unshift({ src: await url(w.poster!), alt: `${w.title}: animation`, video: w.video } as any);
  return { ...w, lb: JSON.stringify({ items, title: w.title, kind: w.kind, blurb: w.blurb, credit: w.credit }) };
}));
const plates = await Promise.all(site.gallery.map(async (g) => ({
  ...g, lb: JSON.stringify({ items: [{ src: await url(g.src, 1600), alt: g.alt }], title: g.title, kind: g.series, blurb: (g as any).blurb ?? 'Digital photograph' }),
})));
const filters = [['all', 'All'], ['artwork', 'Artwork'], ['collection', 'Collection'], ['motion', 'Motion'], ['ux', 'UX']];
---
<section id="design" class="wrap">
  <div class="shead">
    <div class="t"><span class="bul c-pur" aria-hidden="true">D</span><h2>Design</h2></div>
    <div class="chips" role="group" aria-label="Filter design work">
      {filters.map(([f, l], i) => <button type="button" class="chip" data-f={f} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
      <span class="view" role="group" aria-label="Layout">
        <button type="button" class="vbtn" data-view="grid" aria-pressed="true" aria-label="Grid view"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="1" y="9" width="6" height="6"/><rect x="9" y="9" width="6" height="6"/></svg></button>
        <button type="button" class="vbtn" data-view="list" aria-pressed="false" aria-label="List view"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="2" width="14" height="2.5"/><rect x="1" y="7" width="14" height="2.5"/><rect x="1" y="12" width="14" height="2.5"/></svg></button>
      </span>
    </div>
  </div>

  <div class="grid" id="dgrid">
    {tiles.map((w, i) => (
      <button type="button" class:list={['tile', 'reveal', w.size]} data-tags={w.tags.join(' ')} data-lb={w.lb} aria-label={`${w.title}, ${w.kind}. Open`}>
        <div class="med grain" style={(w as any).aspect ? `aspect-ratio:${(w as any).aspect}` : undefined}>
          {w.images.length > 1 && <span class="badge">{w.images.length} images</span>}
          {w.video && <span class="badge">▶ motion</span>}
          {w.video && <video class="hov" muted loop playsinline preload="none" data-src={w.video} aria-hidden="true"></video>}
          {w.size === 'wide' && w.images.length > 1 ? (
            <div class="strip">
              {w.images.slice(0, 5).map((p, k) => <Picture src={img(p)} alt="" formats={['avif', 'webp']} widths={[300, 600]} sizes="(max-width: 760px) 30vw, 15vw" />)}
            </div>
          ) : (
            <Picture src={img(w.video ? w.poster! : w.images[0])} alt="" formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes={w.size === 'big' ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 480px) 100vw, (max-width: 1000px) 50vw, 25vw'} />
          )}
        </div>
        <div class="cap"><span class="n mono">{String(i + 1).padStart(2, '0')}</span><span class="tt"><b>{w.title}</b><span class="k">{w.label}</span></span></div>
        {w.credit && <span class="cred mono">{w.credit}</span>}
      </button>
    ))}
    <a class="tile wide" data-tags="ux" href="/work/commission-hub/">
      <div class="med"><Picture src={commissionCover} alt="" formats={['avif', 'webp']} widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 50vw" style="width:100%;height:100%;object-fit:cover;object-position:top left" /></div>
      <div class="cap"><span class="n mono">UX</span><span class="tt"><b>Sales Commission Hub</b><span class="k">Case study + prototype →</span></span></div>
    </a>
    <a class="tile wide" data-tags="ux" href="/work/laurel/">
      <div class="med"><Picture src={laurelCover} alt="" formats={['avif', 'webp']} widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 50vw" style="width:100%;height:100%;object-fit:cover;object-position:top left" /></div>
      <div class="cap"><span class="n mono">UX</span><span class="tt"><b>Laurel</b><span class="k">Case study + prototype →</span></span></div>
    </a>
  </div>

  <div class="photo-head">
    <h3 class="ph-title">Gallery</h3>
    <div class="railnav">
      <button type="button" aria-label="Previous photographs" data-dir="-1">←</button>
      <button type="button" aria-label="Next photographs" data-dir="1">→</button>
    </div>
  </div>
  <p class="curnote mono">Portraits and self-portraits across four shoots. The purple Bluelight Sessions I styled, lit, shot and edited myself for The Heartbreak Saga. {plates.length} plates.</p>
</section>
<div class="wall dots" id="wall" tabindex="0" role="region" aria-label="Gallery of photographs, scroll sideways">
  {plates.map((g, k) => (
    <figure class="plate">
      <button type="button" class="frame grain" data-lb={g.lb} aria-label={`Enlarge ${g.title}`}>
        <Picture src={img(g.src)} alt={g.alt} formats={['avif', 'webp']} widths={[400, 700]} sizes="(max-width: 760px) 70vw, 360px" />
      </button>
      <figcaption class="label"><span class="no">PLATE {String(k + 1).padStart(2, '0')}</span><b>{g.title}</b><i>{g.series}</i></figcaption>
    </figure>
  ))}
</div>

<script>
  const grid = document.getElementById('dgrid')!;
  document.querySelectorAll<HTMLButtonElement>('#design .chip').forEach((ch) => ch.addEventListener('click', () => {
    document.querySelectorAll('#design .chip').forEach((c) => c.setAttribute('aria-pressed', String(c === ch)));
    const f = ch.dataset.f!;
    grid.querySelectorAll<HTMLElement>('[data-tags]').forEach((t) => {
      t.hidden = !(f === 'all' || t.dataset.tags!.split(' ').includes(f));
    });
  }));
  // grid / list toggle
  document.querySelectorAll<HTMLButtonElement>('#design .vbtn').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('#design .vbtn').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    grid.classList.toggle('list', b.dataset.view === 'list');
  }));
  // motion pieces play a silent loop on hover (or when scrolled into view on touch screens)
  const vids = [...grid.querySelectorAll<HTMLVideoElement>('video.hov')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = (v: HTMLVideoElement) => { if (reduce) return; if (!v.src) v.src = v.dataset.src!; v.play().then(() => v.classList.add('on')).catch(() => {}); };
  const stop = (v: HTMLVideoElement) => { v.pause(); v.classList.remove('on'); };
  if (matchMedia('(hover: hover)').matches) {
    vids.forEach((v) => { const t = v.closest('.tile')!; t.addEventListener('pointerenter', () => start(v)); t.addEventListener('pointerleave', () => stop(v)); });
  } else {
    const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start : stop)(e.target as HTMLVideoElement)), { threshold: 0.6 });
    vids.forEach((v) => io.observe(v));
  }
  const wall = document.getElementById('wall')!;
  document.querySelectorAll<HTMLButtonElement>('#design .railnav button').forEach((b) =>
    b.addEventListener('click', () => wall.scrollBy({ left: wall.clientWidth * 0.7 * Number(b.dataset.dir), behavior: 'smooth' })));
</script>

<style>
  #design{padding-block:96px 0}
  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{min-height:46px;padding:0 20px;border-radius:999px;border:2.5px solid var(--ink);background:transparent;font-weight:800;font-size:15.5px;cursor:pointer}
  .chip[aria-pressed="true"]{background:var(--ink);color:var(--cream)}
  .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;grid-auto-flow:dense}
  .tile{display:flex;flex-direction:column;gap:10px;background:none;border:0;padding:0;text-align:left;cursor:pointer}
  .tile[hidden]{display:none}
  .med{aspect-ratio:1;border-radius:var(--rad);border:3px solid var(--ink);background:#ddd4c2;transition:transform .25s,box-shadow .25s}
  @media (hover:hover){.tile:hover .med{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--ink)}}
  .tile:focus-visible .med{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--ink)}
  .med{position:relative;overflow:hidden}
  .med :global(picture),.med :global(img){width:100%;height:100%;object-fit:cover}
  .hov{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .3s;z-index:1;background:#fff}
  .hov.on{opacity:1}
  .view{display:inline-flex;gap:4px;margin-left:8px;border-left:2px solid var(--ink);padding-left:12px}
  .vbtn{width:44px;height:44px;border-radius:50%;border:2px solid var(--ink);background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--ink)}
  .vbtn svg{fill:currentColor}
  .vbtn[aria-pressed="true"]{background:var(--ink);color:var(--cream)}
  /* list view: a fast index, thumbnails shrink to chips */
  .grid.list{display:flex;flex-direction:column;gap:0;border-top:3px solid var(--ink)}
  .grid.list .tile{flex-direction:row;align-items:center;gap:18px;padding:12px 4px;border-bottom:1.5px solid var(--ink);opacity:1;transform:none}
  .grid.list .tile[hidden]{display:none}
  .grid.list .med{border-radius:8px;width:72px;height:72px;flex:0 0 72px;aspect-ratio:1!important;border-width:2px;box-shadow:none!important;transform:none!important}
  .grid.list .badge,.grid.list .strip :global(picture:not(:first-child)),.grid.list .soonbox span{display:none}
  .grid.list .cap{flex:1;align-items:center}
  .grid.list .cap b{font-size:clamp(18px,2.2vw,26px)}
  .grid.list .tt{flex-direction:row;align-items:baseline;gap:14px;flex-wrap:wrap}
  .grid.list .tile:hover .cap b{text-decoration:underline;text-underline-offset:5px}
  .grid.list .cred{display:none}
  .wide{grid-column:span 2}.wide .med{aspect-ratio:2/1}
  .big{grid-column:span 2;grid-row:span 2}.big .med{aspect-ratio:auto;flex-grow:1;min-height:0}
  .tall{grid-row:span 2}.tall .med{aspect-ratio:auto;flex-grow:1}
  .strip{display:grid;height:100%;grid-auto-flow:column;grid-auto-columns:1fr}
  .strip :global(picture){border-left:3px solid var(--ink)} .strip :global(picture:first-child){border-left:0}
  .badge{position:absolute;top:10px;left:10px;z-index:2;font-family:var(--pixel);font-size:13px;font-weight:400;background:var(--cream);border:2px solid var(--ink);padding:2px 8px}
  .cap{display:flex;align-items:baseline;gap:12px}
  .cap .n{font-size:12px;font-weight:700}
  .tt{display:flex;flex-direction:column;gap:3px;min-width:0}
  .cap b{font-size:18px;font-weight:800;line-height:1.15;overflow-wrap:anywhere}
  .cap .k{font-size:13px;font-weight:700;letter-spacing:.06em}
  .soonbox{border-style:dashed;background:transparent;display:flex;flex-direction:column;justify-content:center;gap:8px;padding:22px}
  .soonbox b{font-size:20px;line-height:1.1} .soonbox .mono{font-size:12px;color:var(--muted)}
  .soon{cursor:default}
  .cred{font-size:11px;color:var(--muted)}

  .photo-head{display:flex;justify-content:space-between;align-items:center;margin-top:96px;border-top:3px solid var(--ink);padding-top:20px}
  .ph-title{margin:0;font-size:clamp(32px,4vw,56px);font-weight:900;letter-spacing:-.03em}
  .railnav{display:flex;gap:8px}
  .railnav button{width:48px;height:48px;border-radius:50%;border:2.5px solid var(--ink);background:transparent;cursor:pointer;font-size:20px;font-weight:700}
  .railnav button:hover{background:var(--ink);color:var(--cream)}
  .curnote{font-size:13px;color:var(--muted);margin:10px 0 28px}
  .wall{display:flex;gap:56px;overflow-x:auto;scroll-snap-type:x mandatory;padding:56px var(--gut) 40px;align-items:flex-end;border-block:3px solid var(--ink);background-color:var(--wall)}
  .plate{flex:0 0 auto;scroll-snap-align:center;display:flex;flex-direction:column;gap:18px;margin:0}
  .frame{background:#fff;padding:clamp(7px,.8vw,11px);border:1px solid rgba(20,20,19,.55);box-shadow:0 18px 30px rgba(20,20,19,.16);cursor:zoom-in;display:block}
  .frame :global(img){height:clamp(340px,48vh,540px);width:auto;max-width:none}
  .plate:nth-child(3n+2) .frame :global(img){height:clamp(280px,40vh,440px)}
  .label{background:#fff;color:#141413;border:1px solid #cfcac0;padding:7px 10px;width:170px;font-size:12px;line-height:1.3;display:flex;flex-direction:column}
  .no{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:#57534a}
  .label b{font-size:13.5px} .label i{font-style:normal;color:#57534a}

  @media (max-width:1000px){
    .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .big{grid-row:span 1}.big .med{aspect-ratio:1}
    .tall{grid-row:span 1}.tall .med{aspect-ratio:4/5}
  }
  @media (max-width:480px){
    .grid{grid-template-columns:1fr}
    .wide,.big{grid-column:span 1}
    .wide .med{aspect-ratio:3/2}
  }
</style>
