---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { img } from '../lib/images';
interface Props { entry: CollectionEntry<'work'>; n: number }
const { entry, n } = Astro.props;
const d = entry.data;
const soon = d.status === 'soon';
const Tag = soon ? 'div' : 'a';
const stack = entry.id === 'album-art' ? ['covers/the-vault.jpg', 'art/thscoverraw-edit.jpg', 'covers/BEAUTIFUL_BROKEN-cover1.jpg', 'covers/snap.jpg', 'covers/summerloveV1.jpg'] : null;
const hues = ['#E63946', '#7B2CBF', '#F4A261', '#2A9D8F', '#E9C46A'];
---
<Tag class:list={['card', 'reveal', { soon }]} href={soon ? undefined : `/work/${entry.id}/`}>
  <div class:list={['med', 'grain', { stack: !!stack }]}>
    {stack ? (
      <div class="crate" aria-hidden="true">
        {stack.map((c, i) => (
          <span class="rec" style={`--i:${i};--h:${hues[i]}`}><span class="disc"></span><span class="slv"><Picture src={img(c)} alt="" formats={['avif', 'webp']} widths={[300, 500]} sizes="200px" /></span></span>
        ))}
      </div>
    ) : <Picture src={d.cover} alt={d.coverAlt} formats={['avif', 'webp']} widths={[600, 1000, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />}
    {d.hover && <video class="whover" src={d.hover} muted loop playsinline preload="none" aria-hidden="true"></video>}
    {d.loop && <video class="wloop" src={d.loop} muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video>}
    {soon && <span class="badge">Coming soon</span>}
  </div>
  <div class="cap">
    <span class="n mono">{String(n).padStart(2, '0')}</span>
    <div>
      <h3>{d.title}</h3>
      <p class="k">{d.role} · {d.lane}</p>
      <p class="sum">{d.summary.replace(/\s*\[TODO[^\]]*\]/g, '')}</p>
    </div>
    {!soon && <span class="go" aria-hidden="true">→</span>}
  </div>
</Tag>

<script>
  document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
    const v = c.querySelector<HTMLVideoElement>('.whover'); if (!v) return;
    c.addEventListener('pointerenter', () => { v.preload = 'auto'; v.currentTime = 0; v.play().catch(() => {}); c.classList.add('hv'); });
    c.addEventListener('pointerleave', () => { v.pause(); c.classList.remove('hv'); });
  });
</script>

<style>
  .card{display:flex;flex-direction:column;gap:14px}
  .med{position:relative;aspect-ratio:4/3;border-radius:var(--rad);overflow:hidden;border:3px solid var(--ink);background:#ddd4c2;transition:transform .25s,box-shadow .25s}
  a.card:hover .med,a.card:focus-visible .med{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--ink)}
  .med :global(picture){display:block;height:100%}
  .whover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:0;transition:opacity .35s}
  .card.hv .whover{opacity:1}
  .stack{background:#141413;display:grid;place-items:center}
  .crate{position:relative;width:86%;height:62%}
  .rec{position:absolute;top:50%;left:calc(var(--i) * 17%);width:34%;aspect-ratio:1;translate:0 -50%;transition:transform .5s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--i) * 40ms)}
  .slv{position:absolute;inset:0;z-index:2;border-radius:4px;overflow:hidden;box-shadow:6px 8px 18px rgba(0,0,0,.55);transform:rotate(calc((var(--i) - 2) * 3deg))}
  .slv :global(img){width:100%;height:100%;object-fit:cover;display:block}
  .disc{position:absolute;inset:5%;z-index:1;border-radius:50%;background:radial-gradient(circle,var(--h) 0 15%,#0b0b0b 15.5% 17%,transparent 17.5%),repeating-radial-gradient(circle,#161616 0 2px,#262626 2px 3px);transition:transform .6s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--i) * 50ms)}
  a.card:hover .rec,a.card:focus-visible .rec{transform:translateY(-10%)}
  a.card:hover .disc,a.card:focus-visible .disc{transform:translateY(-58%) rotate(160deg)}
  .wloop{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%}
  .med :global(img){width:100%;height:100%;object-fit:cover;object-position:top center}
  .soon .med{opacity:.85}
  .badge{position:absolute;top:12px;left:12px;z-index:2;font-family:var(--pixel);font-size:13px;font-weight:400;background:var(--yellow);border:2px solid var(--ink);padding:3px 10px}
  .cap{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start}
  .n{font-size:13px;font-weight:700;padding-top:6px}
  h3{margin:0;font-size:clamp(22px,2.2vw,30px);font-weight:900;letter-spacing:-.025em;line-height:1.05}
  .k{margin:6px 0 0}
  .sum{margin:8px 0 0;font-size:16px;line-height:1.5}
  .go{font-size:28px;font-weight:900;transition:transform .2s}
  a.card:hover .go{transform:translateX(6px)}
</style>
