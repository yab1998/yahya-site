---
// One shared lightbox. Any element with data-lb='{"items":[{src,alt,video?}],"title","kind","blurb","credit"}'
// opens it on click; focus is trapped by the native modal <dialog> and returned to the opener on close.
---
<dialog id="lb" aria-labelledby="lbTitle">
  <div class="lb">
    <div class="stage">
      <button class="x glass" type="button" aria-label="Close">✕</button>
      <div id="lbMedia"></div>
      <button class="arrow prev glass" type="button" aria-label="Previous image">←</button>
      <button class="arrow next glass" type="button" aria-label="Next image">→</button>
    </div>
    <div class="info">
      <span class="k" id="lbKind"></span>
      <h3 id="lbTitle"></h3>
      <p id="lbBlurb"></p>
      <p class="credit" id="lbCredit"></p>
      <div class="thumbs" id="lbThumbs"></div>
    </div>
  </div>
</dialog>

<script>
  type Item = { src: string; alt: string; video?: string };
  type Data = { items: Item[]; title: string; kind?: string; blurb?: string; credit?: string };
  const dlg = document.getElementById('lb') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  let data: Data | null = null, idx = 0, opener: HTMLElement | null = null, dir = 0;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const cache = new Map<string, HTMLImageElement>();
  function load(src: string) {
    let im = cache.get(src);
    if (!im) { im = new Image(); im.decoding = 'async'; im.src = src; cache.set(src, im); }
    return im;
  }
  function preloadAround() {
    if (!data) return; const n = data.items.length;
    [1, -1].forEach((d) => load(data!.items[(idx + d + n) % n].src));
  }
  function buildThumbs() {
    const th = $('lbThumbs'); th.replaceChildren();
    if (!data || data.items.length < 2) return;
    data.items.forEach((t, k) => {
      const b = document.createElement('button'); b.type = 'button';
      b.setAttribute('aria-label', `Show image ${k + 1} of ${data!.items.length}`);
      const im = new Image(); im.src = t.src; im.alt = ''; b.append(im);
      b.onclick = () => go(k, k > idx ? 1 : -1);
      th.append(b);
    });
  }
  function markThumb() {
    $('lbThumbs').querySelectorAll('button').forEach((b, k) => b.toggleAttribute('aria-current', k === idx));
  }
  async function makeMedia(): Promise<HTMLElement> {
    const it = data!.items[idx];
    if (it.video) {
      const v = document.createElement('video');
      Object.assign(v, { src: it.video, poster: it.src, controls: true, autoplay: true, muted: true, loop: true, playsInline: true });
      v.setAttribute('aria-label', it.alt);
      return v;
    }
    const im = load(it.src).cloneNode() as HTMLImageElement; im.alt = it.alt;
    try { await im.decode(); } catch {}
    return im;
  }
  async function render(d = 0) {
    if (!data) return;
    const media = $('lbMedia');
    const el = await makeMedia();
    const old = media.firstElementChild as HTMLElement | null;
    if (d && old && !reduce) {
      await old.animate([{ transform: old.style.transform || 'none', opacity: 1 }, { transform: `translateX(${-d * 40}%)`, opacity: 0 }], { duration: 160, easing: 'ease-in', fill: 'forwards' }).finished;
    }
    media.replaceChildren(el);
    if (d && !reduce) el.animate([{ transform: `translateX(${d * 40}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 260, easing: 'cubic-bezier(.2,.8,.2,1)' });
    $('lbKind').textContent = data.kind ?? '';
    $('lbTitle').textContent = data.title;
    $('lbBlurb').textContent = data.blurb ?? ''; $('lbBlurb').hidden = !data.blurb;
    $('lbCredit').textContent = data.credit ?? ''; $('lbCredit').hidden = !data.credit;
    dlg.querySelectorAll<HTMLElement>('.arrow').forEach((a) => (a.hidden = data!.items.length < 2));
    markThumb(); preloadAround();
  }
  let busy = false;
  async function go(k: number, d: number) {
    if (!data || busy || k === idx) return;
    busy = true; idx = k; await render(d); busy = false;
  }
  function step(d: number) { if (!data || data.items.length < 2) return; const n = data.items.length; go((idx + d + n) % n, d); }

  export async function openLightbox(d: Data, start = 0, from: HTMLElement | null = null) {
    data = d; idx = start; opener = from; buildThumbs();
    await render();
    dlg.showModal();
    // zoom out of the clicked tile: uniform scale so nothing stretches
    const box = dlg.querySelector<HTMLElement>('.lb')!;
    const src = from?.querySelector('.med, .frame, img') as HTMLElement | null;
    const small = matchMedia('(max-width: 760px), (pointer: coarse)').matches;
    if (small && !reduce) {
      box.animate([{ transform: 'translateY(24px)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 260, easing: 'cubic-bezier(.2,.8,.2,1)' });
    } else if (src && !reduce) {
      const a = src.getBoundingClientRect(), b = box.getBoundingClientRect();
      const s = Math.max(.2, Math.min(a.width / b.width, a.height / b.height));
      const tx = a.left + a.width / 2 - (b.left + b.width / 2), ty = a.top + a.height / 2 - (b.top + b.height / 2);
      box.animate([{ transform: `translate(${tx}px,${ty}px) scale(${s})`, opacity: 0 }, { opacity: 1, offset: .35 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'cubic-bezier(.16,1,.3,1)' });
    }
  }
  function closeLightbox() { dlg.close(); }
  dlg.addEventListener('close', () => { $('lbMedia').replaceChildren(); opener?.focus(); });

  dlg.querySelector('.x')!.addEventListener('click', closeLightbox);
  dlg.querySelector('.prev')!.addEventListener('click', () => step(-1));
  dlg.querySelector('.next')!.addEventListener('click', () => step(1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) closeLightbox(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  // swipe: the image follows your finger, then settles
  let x0: number | null = null, y0 = 0, axis: '' | 'x' | 'y' = '';
  const stage = dlg.querySelector<HTMLElement>('.stage')!;
  stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; axis = ''; }, { passive: true });
  stage.addEventListener('touchmove', (e) => {
    if (x0 === null || busy) return;
    const dx = e.touches[0].clientX - x0, dy = e.touches[0].clientY - y0;
    if (!axis && Math.hypot(dx, dy) > 12) axis = Math.abs(dx) > Math.abs(dy) * 1.5 ? 'x' : 'y';
    if (axis !== 'x') return;
    const m = $('lbMedia').firstElementChild as HTMLElement | null;
    if (m) m.style.transform = `translateX(${dx * 0.6}px)`;
  }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    const m = $('lbMedia').firstElementChild as HTMLElement | null;
    if (axis !== 'x') { if (m) m.style.transform = ''; return; }
    if (Math.abs(dx) > 50 && data && data.items.length > 1) step(dx < 0 ? 1 : -1);
    else if (m) { m.animate([{ transform: m.style.transform }, { transform: 'none' }], { duration: 200, easing: 'ease-out' }); m.style.transform = ''; }
  });

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
    if (!el) return;
    e.preventDefault();
    openLightbox(JSON.parse(el.dataset.lb!), Number(el.dataset.lbStart ?? 0), el);
  });
</script>

<style>
  dialog{border:0;padding:0;background:transparent;max-width:min(1100px,94vw);width:100%}
  dialog::backdrop{background:rgba(20,20,19,.88)}
  dialog[open]::backdrop{animation:fade .3s ease}
  @keyframes fade{from{opacity:0}}
  .stage{overflow:hidden;touch-action:pan-y}
  .lb{will-change:transform;border-radius:var(--rad);overflow:hidden;background:var(--cream);border:3px solid var(--ink);display:grid;grid-template-columns:1.4fr 1fr;max-height:90vh}
  .stage{background:#111;display:flex;align-items:center;justify-content:center;position:relative;min-height:320px}
  .stage :global(img),.stage :global(video){max-height:86vh;width:100%;object-fit:contain}
  .info{padding:28px;display:flex;flex-direction:column;gap:14px;overflow:auto}
  h3{margin:0;font-size:32px;font-weight:900;letter-spacing:-.03em;line-height:1}
  .info p{margin:0;line-height:1.55}
  .thumbs{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto}
  .thumbs :global(button){width:58px;height:58px;padding:0;border:2px solid var(--ink);cursor:pointer;background:none;opacity:.55}
  .thumbs :global(button[aria-current]){opacity:1;outline:3px solid var(--blue)}
  .thumbs :global(img){width:100%;height:100%;object-fit:cover}
  .x{position:absolute;top:10px;right:10px;width:44px;height:44px;border-radius:50%;font-size:20px;cursor:pointer;z-index:3}
  .arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;cursor:pointer;font-weight:700;z-index:3}
  .arrow[hidden]{display:none}
  .prev{left:10px}.next{right:10px}
  @media (max-width:1000px){.lb{grid-template-columns:1fr;overflow:auto}.stage :global(img),.stage :global(video){max-height:55vh}}
</style>
