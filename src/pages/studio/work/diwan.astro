---
import { Picture } from 'astro:assets';
import { img, url } from '../../../lib/images';
const groups = [
  { k: 'carousel', t: 'what does diwan do?', d: 'A three-part Instagram carousel that explains, plainly, what a gift actually pays for.', imgs: ['ig-part-1', 'ig-part-2', 'ig-part-3', 'email-parents'] },
  { k: 'givingday', t: 'giving day', d: 'Posts and stories for Cornell Giving Day: the ask, the link, and a nudge for every budget.', imgs: ['stories-1', 'dayof-6', 'stories-2', 'dayof-7', 'dayof-5'] },
  { k: 'ramadan', t: 'ramadan', d: 'Making the cost of a Ramadan on campus concrete, down to the dates.', imgs: ['dayof-1', 'dayof-4'] },
  { k: 'letters', t: '100 hands · letters home', d: 'Letters for parents, alumni and families, shared over email and WhatsApp, asking for one of 100 hands.', imgs: ['parents', 'whatsapp-general', 'programs-1', 'programs-2'] },
];
const all = groups.flatMap((g) => g.imgs);
const lb = Object.fromEntries(await Promise.all(all.map(async (n) => [n, await url(`studio/diwan/${n}.jpg`, 1080)])));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>the diwan foundation | lunar lighthouse</title>
  <meta name="description" content="Fundraising campaigns for The Diwan Foundation for Cornell Muslim Life: 100 Hands, Giving Day and Ramadan." />
  <link rel="icon" href="/ll-mark-color.svg" type="image/svg+xml" />
</head>
<body>
  <nav class="nav"><a class="mark" href="/studio/"><img src="/ll-mark-green.svg" alt="" width="40" height="48" /><span>lunar lighthouse</span></a><a href="/studio/#work">← all work</a></nav>
  <main>
    <header class="head">
      <p class="kick">case study · nonprofit fundraising</p>
      <h1 class="hl"><span class="ln"><span>the diwan foundation</span></span></h1>
      <p class="intro">The 100 Hands campaign, Giving Day and Ramadan fundraisers for Cornell Muslim Life, redesigned top to bottom: new digital assets, email copy and posting schedules.</p>
      <dl class="meta"><div><dt>client</dt><dd>The Diwan Foundation for Cornell Muslim Life</dd></div><div><dt>campaigns</dt><dd>100 Hands · Giving Day · Ramadan</dd></div><div><dt>services</dt><dd>campaign design, copy, scheduling</dd></div><div><dt>result</dt><dd>~$40K raised per campaign</dd></div></dl>
    </header>

    <div class="fan r" aria-hidden="true">
      {['ig-part-1', 'stories-1', 'dayof-1', 'dayof-6', 'dayof-4'].map((n, i) => <span style={`--i:${i}`}><Picture src={img(`studio/diwan/${n}.jpg`)} alt="" formats={['avif', 'webp']} widths={[400, 700]} sizes="30vw" /></span>)}
    </div>

    {groups.map((g, gi) => (
      <section class={`grp r ${g.k}`}>
        <div class="gh"><span class="gn">0{gi + 1}</span><h2>{g.t}</h2><p>{g.d}</p></div>
        <div class="gg">
          {g.imgs.map((n) => (
            <button type="button" class="tile" data-src={lb[n]} aria-label={`Enlarge ${g.t} post`}>
              <Picture src={img(`studio/diwan/${n}.jpg`)} alt={`${g.t} post for The Diwan Foundation`} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 820px) 50vw, 25vw" />
            </button>
          ))}
        </div>
      </section>
    ))}

    <section class="out r">
      <div><b>3</b><span>campaigns</span></div>
      <div><b>15+</b><span>posts, stories and letters</span></div>
      <div><b>$40K</b><span>raised each time</span></div>
    </section>

    <a class="next" href="/studio/work/demo/"><span>next project</span><b>straightway ethical advisory →</b></a>
  </main>
  <dialog class="zoom"><button type="button" class="zx" aria-label="Close">✕</button><img alt="" /></dialog>
  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .1 });
    document.querySelectorAll('.r').forEach((el) => io.observe(el));
    const dlg = document.querySelector<HTMLDialogElement>('dialog.zoom')!; const zi = dlg.querySelector('img')!;
    document.querySelectorAll<HTMLButtonElement>('.tile').forEach((b) => b.addEventListener('click', () => { zi.src = b.dataset.src!; zi.alt = b.getAttribute('aria-label')!.replace('Enlarge ', ''); dlg.showModal(); }));
    dlg.addEventListener('click', () => dlg.close());
  </script>
</body>
</html>
<style is:global>
  @font-face{font-family:'EB Garamond';font-weight:500;font-display:swap;src:url(/fonts/eb-garamond-latin-500-normal.woff2) format('woff2')}
  @font-face{font-family:'EB Garamond';font-weight:600;font-display:swap;src:url(/fonts/eb-garamond-latin-600-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:400;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-400-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:600;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-600-normal.woff2) format('woff2')}
  :root{--g:#588158;--g-d:#3f633f;--ink:#111;--serif:'EB Garamond',Georgia,serif;--mono:'IBM Plex Mono',ui-monospace,monospace;--pad:clamp(20px,5vw,72px)}
  *{box-sizing:border-box} body{margin:0;background:#fff;color:var(--ink);font-family:var(--mono);font-size:17px;line-height:1.55}
  a{color:inherit} h1,h2{font-family:var(--serif);font-weight:600;letter-spacing:-.03em;line-height:.95;margin:0}
  .nav{display:flex;justify-content:space-between;align-items:center;padding:24px var(--pad);position:sticky;top:0;background:rgba(255,255,255,.85);backdrop-filter:blur(10px);z-index:5}
  .nav a{text-decoration:none}.mark{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-weight:600;font-size:22px;color:var(--g-d)}.mark img{width:36px;height:auto}
  .head{padding:clamp(40px,8vw,120px) var(--pad) clamp(32px,5vw,64px)}
  .kick{font-size:13px;text-transform:uppercase;letter-spacing:.14em;color:var(--g-d);margin:0 0 20px}
  .hl{font-size:clamp(52px,9vw,150px)}.hl .ln{display:block;overflow:hidden;padding:.14em 0 .22em;margin:-.14em 0 -.22em}.hl .ln>span{display:block;transform:translateY(105%);animation:up 1.1s cubic-bezier(.16,1,.3,1) forwards}
  @keyframes up{to{transform:none}}
  .intro{font-size:clamp(19px,1.9vw,26px);max-width:40ch;margin:32px 0 48px}
  .meta{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin:0;border-top:1.5px solid var(--ink);padding-top:20px}
  .meta dt{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#666}.meta dd{margin:4px 0 0;font-family:var(--serif);font-size:20px}
  .ph{position:relative;background:repeating-linear-gradient(135deg,#eef3ec 0 14px,#e3ebe0 14px 28px);border-radius:18px;aspect-ratio:4/5;display:grid;place-items:center}
  .ph::after{content:attr(data-l);font-size:13px;color:var(--g-d);background:#fff;border:1.5px solid var(--g);border-radius:999px;padding:6px 14px;text-align:center;max-width:80%}
  .full{margin:0 var(--pad);aspect-ratio:16/9}.full.tall{aspect-ratio:3/2}
  .two,.three{display:grid;gap:clamp(14px,2vw,28px);padding:0 var(--pad);margin:clamp(14px,2vw,28px) 0}
  .two{grid-template-columns:1fr 1fr}.three{grid-template-columns:repeat(3,1fr)}.three .ph{aspect-ratio:1}
  .cols{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(24px,6vw,96px);padding:clamp(64px,9vw,140px) var(--pad)}
  .cols h2,.sys h2{font-size:clamp(44px,5.5vw,88px)} h2 em{color:var(--g);font-style:italic}
  .cols p{margin:0 0 18px;max-width:52ch}.cols ol{padding-left:20px;display:flex;flex-direction:column;gap:8px}
  .sys{padding:clamp(64px,9vw,140px) var(--pad);display:grid;gap:40px}
  .sw{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.sw div{background:var(--c);color:var(--t,#fff);border-radius:18px;aspect-ratio:1/1.1;padding:18px;display:flex;flex-direction:column;justify-content:flex-end;font-family:var(--serif);font-size:24px;border:1.5px solid rgba(0,0,0,.08)}.sw code{font-family:var(--mono);font-size:13px;opacity:.8}
  .type{display:flex;gap:40px;align-items:center;border-top:1.5px solid var(--ink);padding-top:28px}.type .big{font-family:var(--serif);font-size:clamp(100px,14vw,220px);line-height:.8;margin:0}.type span{color:#666;font-size:14px}
  .quote{background:var(--g);color:#fff;margin:clamp(40px,6vw,96px) 0 0;padding:clamp(64px,10vw,160px) var(--pad)}
  .quote p{font-family:var(--serif);font-style:italic;font-size:clamp(34px,4.6vw,72px);line-height:1.05;max-width:22ch;margin:0 0 24px}
  .out{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1.5px solid var(--ink)}.out div{padding:48px var(--pad);border-right:1.5px solid var(--ink);display:flex;flex-direction:column}.out div:last-child{border:0}
  .out b{font-family:var(--serif);font-size:clamp(64px,8vw,130px);line-height:1;color:var(--g)}
  .next{display:flex;flex-direction:column;gap:8px;padding:clamp(64px,10vw,150px) var(--pad);text-decoration:none;background:var(--ink);color:#fff}
  .next span{font-size:13px;text-transform:uppercase;letter-spacing:.14em;color:#9cc49a}.next b{font-family:var(--serif);font-weight:500;font-size:clamp(44px,7vw,120px);letter-spacing:-.03em;transition:transform .4s cubic-bezier(.2,.7,.2,1)}.next:hover b{transform:translateX(18px)}
  .r{opacity:0;transform:translateY(32px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}.r.in{opacity:1;transform:none}

  .fan{position:relative;height:clamp(260px,34vw,480px);margin:0 var(--pad) clamp(40px,6vw,80px);background:#1d5fa8;border-radius:18px;overflow:hidden}
  .fan span{position:absolute;top:50%;left:calc(8% + var(--i) * 17%);width:clamp(140px,20vw,280px);aspect-ratio:1;translate:0 -50%;rotate:calc((var(--i) - 2) * 5deg);border-radius:10px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,.35);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .fan span:nth-child(odd){translate:0 -44%}
  .fan:hover span{transform:translateY(-14px) rotate(calc((var(--i) - 2) * -3deg))}
  .fan img{width:100%;height:100%;object-fit:cover;display:block}
  .grp{padding:clamp(40px,6vw,90px) var(--pad);border-top:1.5px solid var(--ink)}
  .gh{display:grid;grid-template-columns:60px 1fr 1.2fr;gap:20px;align-items:baseline;margin-bottom:28px}
  .gn{font-size:13px;color:var(--g-d)}.gh h2{font-size:clamp(36px,4.5vw,68px)}.gh p{margin:0;max-width:44ch}
  .gg{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:clamp(12px,1.6vw,22px)}
  .tile{display:block;aspect-ratio:1;padding:0;border:0;background:none;cursor:zoom-in;border-radius:12px;overflow:hidden;box-shadow:0 10px 24px -12px rgba(0,0,0,.35);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
  .tile:hover,.tile:focus-visible{transform:translateY(-6px) rotate(-1deg);box-shadow:0 22px 40px -14px rgba(0,0,0,.45)}
  .tile img,.tile picture{width:100%;height:100%;object-fit:cover;display:block}
  .zoom{border:0;padding:0;background:transparent;max-width:min(92vw,880px)}.zoom::backdrop{background:rgba(10,10,10,.88)}.zoom img{width:100%;height:auto;display:block;border-radius:10px}
  .zx{position:fixed;top:16px;right:16px;width:44px;height:44px;border-radius:50%;border:2px solid #fff;background:transparent;color:#fff;font-size:18px;cursor:pointer}
  @media (max-width:820px){.gh{grid-template-columns:1fr}.fan span{width:36vw}}
  @media (max-width:820px){.meta{grid-template-columns:1fr 1fr}.cols{grid-template-columns:1fr}.two,.three,.out{grid-template-columns:1fr}.out div{border-right:0;border-bottom:1.5px solid var(--ink)}.sw{grid-template-columns:1fr 1fr}}
  @media (prefers-reduced-motion:reduce){.r{opacity:1;transform:none;transition:none}.hl .ln>span{animation:none;transform:none}}
</style>
