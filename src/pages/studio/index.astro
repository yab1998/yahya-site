---
import { Picture, getImage } from 'astro:assets';
import portrait from '../../assets/photos/blueshootscutesmilemaroonsweater-edited.jpg';
import site from '../../data/site.json';

const projects = [
  { name: 'the diwan foundation', tag: 'Nonprofit · campaigns + reporting', text: 'Campaign and impact-report design for a nonprofit, turning programs and numbers into stories donors actually read.' },
  { name: 'the crescent school', tag: 'Education · identity + web', text: 'Crescent School is a K–12 private school in Hempstead, NY that provides high-quality Islamic education to students from all backgrounds.' },
  { name: 'straightway ethical advisory', tag: 'Finance · brand + digital', text: 'Brand and digital design for an ethical advisory firm, built to feel trustworthy, clear and human.' },
];
const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const canonical = new URL('/studio/', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>lunar lighthouse | independent creative studio, NYC</title>
  <meta name="description" content="lunar lighthouse is an independent creative studio by Yahya Abdul-Basser: logos, brand identity, creative direction and digital storytelling for mission-driven teams." />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content="lunar lighthouse" />
  <meta property="og:description" content="Independent creative studio in New York. Brand identity, creative direction and digital storytelling." />
  <meta property="og:image" content={new URL(og.src, Astro.site)} />
  <meta name="theme-color" content="#588158" />
  <link rel="icon" href="/ll-mark-color.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/eb-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <main id="main">
    <section class="hero">
      <div class="left dots">
        <h1>we are<br />lunar<br />lighthouse.</h1>
        <img class="lh" src="/ll-mark-color.svg" alt="Lunar Lighthouse illustration: a striped lighthouse on the shore under a crescent moon and stars" width="300" height="360" />
      </div>
      <div class="right">
        <nav class="nav" aria-label="Studio">
          <a class="mark" href="/studio/" aria-label="lunar lighthouse home"><img src="/ll-mark-green.svg" alt="" width="54" height="65" /><span>lunar lighthouse</span></a>
          <span><a href="#work">work.</a><a href="#contact">contact me.</a></span>
        </nav>
        <h2>about lunar</h2>
        <p class="lead"><b>lunar lighthouse</b> is an independent creative studio crafting thoughtful, human-centered design and digital storytelling.</p>
        <Picture class="me" src={portrait} alt="Portrait of Yahya against a purple backdrop" formats={['avif', 'webp']} widths={[240, 480]} sizes="120px" />
        <p class="bio">I'm <b>Yahya</b>. I've been freelancing since 2019 and named the studio in 2023. I'm a New York-based creative blending design thinking, psychology and storytelling to solve complex problems, shape user experiences and curate compelling digital narratives.</p>
        <ul class="svc">
          <li>logos + brand identity</li><li>creative direction</li><li>campaign + social design</li><li>websites + digital</li>
        </ul>
      </div>
    </section>

    <section id="work" class="work">
      <h2>latest projects</h2>
      <p class="sub"><b>lunar lighthouse</b> works with mission-driven organizations, schools and small brands on identity, campaigns and digital.</p>
      <div class="cards">
        {projects.map((p, i) => (
          <article class="card" style={`--o:${[0, 110, -8][i]}px`}>
            <div class="top"><h3>{p.name}</h3></div>
            <div class="bot">
              <p class="tag">{p.tag}</p>
              <p>{p.text}</p>
              <a class="pill" href="#contact">Start something similar</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="contact">
      <form class="form" name="studio-inquiry" method="POST" action="/studio/thanks/" data-netlify="true" netlify-honeypot="company-website">
        <h2>contact us</h2>
        <input type="hidden" name="form-name" value="studio-inquiry" />
        <p class="hp"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Organization or brand<input name="organization" autocomplete="organization" /></label>
        <div class="two">
          <label>Project type
            <select name="type" required>
              <option value="">Choose one</option><option>Logo / brand identity</option><option>Creative direction</option><option>Campaign / social design</option><option>Website</option><option>Something else</option>
            </select>
          </label>
          <label>Budget
            <select name="budget">
              <option value="">Not sure yet</option><option>Under $1,000</option><option>$1,000–$3,000</option><option>$3,000–$7,500</option><option>$7,500+</option>
            </select>
          </label>
        </div>
        <label>Tell me about the project<textarea name="message" rows="6" required placeholder="What you're making, who it's for, and when you need it."></textarea></label>
        <button type="submit">Send</button>
      </form>
      <div class="about">
        <h2>how it works</h2>
        <p><b>lunar lighthouse</b> takes on a small number of paid projects at a time, so each one gets real attention.</p>
        <ol>
          <li><b>Intro call.</b> 20 minutes to hear what you're building and whether we're a fit.</li>
          <li><b>Proposal.</b> Scope, timeline and a flat price, in writing.</li>
          <li><b>Make.</b> Concepts, one round of direction, then refinement.</li>
          <li><b>Hand-off.</b> Final files, a simple guide to using them, and support after launch.</li>
        </ol>
        <p class="alt">Prefer email? <a href={`mailto:${site.email}?subject=lunar%20lighthouse%20inquiry`}>{site.email}</a></p>
      </div>
    </section>
  </main>
  <footer class="foot">
    <div><b>made in new york</b><br />by <a href="/">yahya abdul-basser</a><br /><br /><b>© 2026 · est. 2023</b><br />lunar lighthouse creative</div>
    <div><b class="fh">work</b>{projects.map((p) => <a href="#work">{p.name.replace('the ', '')}</a>)}</div>
    <div><b class="fh">contact us</b><a href={`mailto:${site.email}`}>email</a><a href="/">personal site</a><a href={site.socials[0].url} target="_blank" rel="noopener">instagram</a></div>
  </footer>
</body>
</html>

<style is:global>
  @font-face{font-family:'EB Garamond';font-weight:500;font-display:swap;src:url(/fonts/eb-garamond-latin-500-normal.woff2) format('woff2')}
  @font-face{font-family:'EB Garamond';font-weight:600;font-display:swap;src:url(/fonts/eb-garamond-latin-600-normal.woff2) format('woff2')}
  @font-face{font-family:'EB Garamond';font-weight:700;font-display:swap;src:url(/fonts/eb-garamond-latin-700-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:400;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-400-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:600;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-600-normal.woff2) format('woff2')}
  :root{--g:#588158;--g-d:#3f633f;--ink:#111;--paper:#fff;--grey:#d9d9d9;--serif:'EB Garamond',Georgia,serif;--mono:'IBM Plex Mono',ui-monospace,monospace}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--mono);font-size:17px;line-height:1.5}
  a{color:inherit}
  img{display:block;max-width:100%}
  h1,h2,h3{font-family:var(--serif);font-weight:600;letter-spacing:-.02em;line-height:1;margin:0}
  .skip{position:absolute;left:-9999px}.skip:focus{left:16px;top:16px;background:#fff;padding:8px 12px;z-index:9}
  .dots{background-color:var(--g);background-image:radial-gradient(rgba(0,0,0,.09) 2.2px,transparent 2.6px);background-size:22px 22px}
  .hero{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;border-bottom:4px solid var(--ink)}
  .left{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(32px,5vw,72px) clamp(24px,5vw,72px) 0;overflow:hidden}
  .left h1{color:#fff;font-size:clamp(56px,7.6vw,118px);line-height:.98}
  .left .lh{display:block;width:min(100%,460px);height:auto;margin:32px auto 0}
  .right{padding:clamp(32px,5vw,72px) clamp(24px,5vw,80px)}
  .nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:clamp(40px,7vh,80px)}
  .mark{display:flex;align-items:center;gap:12px;font-family:var(--serif);font-weight:600;font-size:24px;text-decoration:none;letter-spacing:-.01em;color:var(--g-d)}.mark img{width:46px;height:auto}
  .nav span{display:flex;gap:22px}.nav span a{text-decoration:none;font-size:18px}.nav span a:hover{text-decoration:underline;text-underline-offset:5px}
  .right h2{font-size:clamp(44px,4.6vw,68px);margin-bottom:28px}
  .lead{font-size:clamp(19px,1.7vw,24px);line-height:1.4;max-width:30ch;margin:0 0 clamp(32px,6vh,72px)}
  .right .me{width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:24px}
  .bio{max-width:38ch;margin:0 0 28px}
  .svc{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}
  .svc li{border:1.5px solid var(--ink);border-radius:999px;padding:4px 14px;font-size:14px}
  .work{background:var(--g);color:#fff;padding:clamp(56px,8vw,112px) clamp(24px,4.5vw,64px) clamp(80px,10vw,140px)}
  .work h2{font-size:clamp(44px,5vw,72px);margin-bottom:20px}
  .work .sub{font-size:clamp(17px,1.6vw,22px);max-width:62ch;margin:0 0 56px}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,40px);align-items:start}
  .card{border:1.5px solid rgba(255,255,255,.9);border-radius:16px;overflow:hidden;transform:translateY(var(--o));transition:transform .3s}
  .card:hover{transform:translateY(calc(var(--o) - 6px))}
  .card .top{min-height:270px;padding:28px 24px;background:var(--g)}
  .card h3{font-size:clamp(36px,3.4vw,52px);font-weight:500}
  .card .bot{background:var(--grey);color:var(--ink);padding:24px}
  .card .tag{font-family:var(--serif);font-weight:700;font-size:22px;margin:0 0 10px}
  .card .bot p{margin:0 0 20px;font-size:15px}
  .pill{display:inline-block;border:1.5px solid var(--ink);border-radius:999px;padding:6px 22px;font-family:var(--serif);font-weight:700;font-size:18px;text-decoration:none}
  .pill:hover{background:var(--ink);color:var(--grey)}
  .contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,96px);padding:clamp(64px,9vw,140px) clamp(24px,7vw,116px)}
  .form{border:2px solid var(--ink);border-radius:14px;padding:clamp(22px,2.5vw,32px);display:flex;flex-direction:column;gap:14px}
  .form h2{color:var(--g);font-size:clamp(40px,3.6vw,54px);margin-bottom:8px}
  .form label{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600}
  .form input,.form select,.form textarea{font:inherit;font-weight:400;font-size:16px;border:2px solid var(--g);border-radius:12px;padding:12px 14px;background:#fff;color:var(--ink);width:100%}
  .form input:focus,.form select:focus,.form textarea:focus{outline:3px solid rgba(88,129,88,.35);outline-offset:1px}
  .form .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .form button{align-self:flex-end;font-family:var(--serif);font-weight:700;font-size:22px;color:var(--g);background:#fff;border:2px solid var(--g);border-radius:12px;padding:6px 56px;cursor:pointer}
  .form button:hover{background:var(--g);color:#fff}
  .hp{position:absolute;left:-9999px}
  .about h2{font-size:clamp(44px,4.4vw,64px);margin:clamp(24px,5vw,80px) 0 18px}
  .about p{font-size:clamp(17px,1.5vw,20px);max-width:40ch}
  .about ol{padding-left:22px;display:flex;flex-direction:column;gap:12px;max-width:44ch;font-size:16px}
  .alt a{text-underline-offset:4px}
  .foot{background:var(--g);color:#fff;display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:32px;padding:clamp(48px,6vw,80px) clamp(24px,7vw,116px);font-family:var(--serif);font-size:22px;line-height:1.35}
  .foot div{display:flex;flex-direction:column;gap:10px}
  .foot div:first-child{display:block}
  .foot .fh{font-size:32px;margin-bottom:4px}
  .foot a{text-decoration:none}.foot a:hover{text-decoration:underline;text-underline-offset:4px}
  @media (max-width:900px){
    .hero{grid-template-columns:1fr}
    .left{min-height:auto}
    .cards{grid-template-columns:1fr}.card{transform:none}.card:hover{transform:none}.card .top{min-height:160px}
    .contact{grid-template-columns:1fr}.about h2{margin-top:0}
    .foot{grid-template-columns:1fr}
  }
  @media (max-width:520px){.form .two{grid-template-columns:1fr}.nav span{gap:14px}.nav span a{font-size:16px}}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card,.card:hover{transition:none}}
</style>
