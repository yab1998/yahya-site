---
import { Picture, getImage } from 'astro:assets';
import portrait from '../../assets/photos/blueshootscutesmilemaroonsweater-edited.jpg';
import site from '../../data/site.json';
import banner from '../../assets/studio/banner.svg?raw';

const projects = [
  { name: 'the diwan foundation', tag: 'Nonprofit · campaigns + reporting', text: 'Campaign and impact-report design for a nonprofit, turning programs and numbers into stories donors actually read.' },
  { name: 'the crescent school', tag: 'Education · identity + web', text: 'Crescent School is a K–12 private school in Hempstead, NY that provides high-quality Islamic education to students from all backgrounds.' },
  { name: 'straightway ethical advisory', tag: 'Finance · brand + digital', text: 'Brand and digital design for an ethical advisory firm, built to feel trustworthy, clear and human.' },
];
const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const canonical = new URL('/studio/', Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>lunar lighthouse | independent creative studio, NYC</title>
  <meta name="description" content="lunar lighthouse is an independent creative studio by Yahya Abdul-Basser: logos, brand identity, creative direction and digital storytelling for mission-driven teams." />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content="lunar lighthouse" />
  <meta property="og:description" content="Independent creative studio in New York. Brand identity, creative direction and digital storytelling." />
  <meta property="og:image" content={new URL(og.src, Astro.site)} />
  <meta name="theme-color" content="#588158" />
  <link rel="icon" href="/ll-mark-color.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/eb-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <main id="main">
    <section class="hero">
      <nav class="nav" aria-label="Studio">
        <a class="mark" href="/studio/" aria-label="lunar lighthouse home"><img src="/ll-mark-green.svg" alt="" width="54" height="65" /><span>lunar lighthouse</span></a>
        <span><time class="clock" aria-label="Local time in New York">nyc --:--</time><a href="#about">about.</a><a href="#work">work.</a><a href="#contact">contact me.</a></span>
      </nav>
      <h1 class="hl" aria-label="we are lunar lighthouse."><span class="ln" aria-hidden="true"><span>we are lunar</span></span><span class="ln" aria-hidden="true"><span>lighthouse<span class="dot">.</span></span></span></h1>
      <div class="banner" set:html={banner} />
    </section>

    <div class="mq" aria-hidden="true"><div class="mqt">{[0,1].map(() => ['logos + brand identity','creative direction','campaigns + social','websites + digital','storytelling'].map((w) => <><span>{w}</span><i>✦</i></>))}</div></div>

    <section id="about" class="about-sec dots">
      <div class="col">
        <h2 class="rise">about lunar</h2>
        <p class="lead hi" data-hi>{"lunar lighthouse is an independent creative studio crafting thoughtful, human-centered design and digital storytelling.".split(" ").map((w) => <span>{w} </span>)}</p>
      </div>
      <div class="col rise">
        <Picture class="me" src={portrait} alt="Portrait of Yahya against a purple backdrop" formats={['avif', 'webp']} widths={[240, 480]} sizes="120px" />
        <p class="bio">I'm <b>Yahya</b>. I've been freelancing since 2019 and named the studio in 2023. I'm a New York-based creative blending design thinking, psychology and storytelling to solve complex problems, shape user experiences and curate compelling digital narratives.</p>
        <ul class="svc">
          <li>logos + brand identity</li><li>creative direction</li><li>campaign + social design</li><li>websites + digital</li>
        </ul>
      </div>
    </section>

    <section id="work" class="work">
      <h2 class="rise">latest projects</h2>
      <p class="sub rise"><b>lunar lighthouse</b> works with mission-driven organizations, schools and small brands on identity, campaigns and digital.</p>
      <ol class="plist">
        {projects.map((p, i) => (
          <li class="prow rise" data-i={i}>
            <a href={i === 2 ? '/studio/work/demo/' : '#contact'}>
              <span class="num">0{i + 1}</span>
              <span class="pname">{p.name}</span>
              <span class="ptag">{p.tag}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <p class="ptext">{p.text}</p>
          </li>
        ))}
      </ol>
      <div class="peek" aria-hidden="true">{projects.map((p) => (<div class="pv"><b>{p.tag}</b><p>{p.text}</p><span>start something similar →</span></div>))}</div>
      <p class="clients rise"><span>trusted by</span> the diwan foundation · the crescent school · straightway ethical advisory · <i>and friends with big ideas</i></p>
    </section>

    <section class="idea">
      <h2 class="rise">have an <em>idea?</em></h2>
      <a class="mag" href="#contact"><span>let's make it ↗</span></a>
    </section>

    <section id="contact" class="contact">
      <form class="form" name="studio-inquiry" method="POST" action="/studio/thanks/" data-netlify="true" netlify-honeypot="company-website">
        <h2>let's <em>talk.</em></h2>
        <p class="fsub">Tell me a little about it, and grab a time for a free 20-minute intro call.</p>
        <input type="hidden" name="form-name" value="studio-inquiry" />
        <p class="hp"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>
        <div class="two">
          <label class="fl"><input name="name" required autocomplete="name" placeholder=" " /><span>your name</span></label>
          <label class="fl"><input name="email" type="email" required autocomplete="email" placeholder=" " /><span>email</span></label>
        </div>
        <label class="fl"><input name="organization" autocomplete="organization" placeholder=" " /><span>organization or brand</span></label>
        <fieldset class="chips"><legend>what do you need?</legend>
          {['logo / brand identity', 'creative direction', 'campaign / social', 'website', 'something else'].map((t, k) => <label><input type="radio" name="type" value={t} required={k === 0} /><span>{t}</span></label>)}
        </fieldset>
        <fieldset class="chips"><legend>budget</legend>
          {['not sure yet', 'under $1k', '$1k–3k', '$3k–7.5k', '$7.5k+'].map((t) => <label><input type="radio" name="budget" value={t} /><span>{t}</span></label>)}
        </fieldset>
        <label class="fl"><textarea name="message" rows="4" required placeholder=" "></textarea><span>tell me about the project</span></label>
        <fieldset class="cal"><legend>book an intro call <i>(optional)</i></legend>
          <div class="days" role="group" aria-label="Pick a day"></div>
          <div class="slots" role="group" aria-label="Pick a time (Eastern)"></div>
          <p class="pick" aria-live="polite">pick a day, then a time (eastern time)</p>
          <input type="hidden" name="call_time" />
        </fieldset>
        <button type="submit" class="send"><span>send it</span><b aria-hidden="true">↗</b></button>
      </form>
      <div class="about">
        <h2>how it works</h2>
        <p><b>lunar lighthouse</b> takes on a small number of paid projects at a time, so each one gets real attention.</p>
        <ol>
          <li><b>Intro call.</b> 20 minutes to hear what you're building and whether we're a fit.</li>
          <li><b>Proposal.</b> Scope, timeline and a flat price, in writing.</li>
          <li><b>Make.</b> Concepts, one round of direction, then refinement.</li>
          <li><b>Hand-off.</b> Final files, a simple guide to using them, and support after launch.</li>
        </ol>
        <p class="alt">Prefer email? <a href={`mailto:${site.email}?subject=lunar%20lighthouse%20inquiry`}>{site.email}</a></p>
      </div>
    </section>
  </main>
  <footer class="foot">
    <div><b>made in new york</b><br />by <a href="/">yahya abdul-basser</a><br /><br /><b>© 2026 · est. 2023</b><br />lunar lighthouse creative</div>
    <div><b class="fh">work</b>{projects.map((p) => <a href="#work">{p.name.replace('the ', '')}</a>)}</div>
    <div><b class="fh">contact us</b><a href={`mailto:${site.email}`}>email</a><a href="/">personal site</a><a href={site.socials[0].url} target="_blank" rel="noopener">instagram</a></div>
  </footer>
  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
    document.querySelectorAll('.rise').forEach((el, i) => { el.style.setProperty('--i', String(i % 4)); reduce ? el.classList.add('in') : io.observe(el); });
    const peek = document.querySelector<HTMLElement>('.peek'); const list = document.querySelector('.plist');
    if (peek && list && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
      const loop = () => { x += (tx - x) * .22; y += (ty - y) * .22; peek.style.transform = `translate(${x}px,${y}px)`; raf = requestAnimationFrame(loop); };
      list.addEventListener('pointermove', (e) => { const r = (list as HTMLElement).getBoundingClientRect(); tx = (e as PointerEvent).clientX - r.left + 28; ty = (e as PointerEvent).clientY - r.top + 18; });
      list.querySelectorAll<HTMLElement>('.prow').forEach((row) => row.addEventListener('pointerenter', () => { peek.dataset.i = row.dataset.i; peek.classList.add('on'); }));
      list.addEventListener('pointerenter', () => { if (!raf) loop(); });
      list.addEventListener('pointerleave', () => { peek.classList.remove('on'); cancelAnimationFrame(raf); raf = 0; });
    }
    const clk = document.querySelector('.clock');
    const tick = () => { if (clk) clk.textContent = 'nyc ' + new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(new Date()).toLowerCase(); };
    tick(); setInterval(tick, 15000);
    const hi = document.querySelector<HTMLElement>('[data-hi]');
    if (hi) { const ws = [...hi.children] as HTMLElement[]; const upd = () => { const r = hi.getBoundingClientRect(); const p = Math.min(1, Math.max(0, (innerHeight * .85 - r.top) / (r.height + innerHeight * .4))); const n = Math.round(p * ws.length); ws.forEach((w, k) => w.classList.toggle('on', reduce || k < n)); }; addEventListener('scroll', upd, { passive: true }); upd(); }
    const mag = document.querySelector<HTMLElement>('.mag');
    if (mag && !reduce && matchMedia('(pointer: fine)').matches) {
      mag.addEventListener('pointermove', (e) => { const r = mag.getBoundingClientRect(); mag.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .3}px,${(e.clientY - r.top - r.height / 2) * .35}px)`; });
      mag.addEventListener('pointerleave', () => { mag.style.transform = ''; });
    }
    // intro-call picker: next 10 weekdays, fixed eastern-time slots
    const days = document.querySelector('.cal .days'), slots = document.querySelector('.cal .slots');
    const out = document.querySelector<HTMLInputElement>('.cal input[name=call_time]'), pick = document.querySelector('.cal .pick');
    if (days && slots && out && pick) {
      const times = ['10:00 am', '12:00 pm', '2:00 pm', '4:00 pm', '6:00 pm'];
      let day = '';
      const d = new Date(); const list: Date[] = [];
      while (list.length < 10) { d.setDate(d.getDate() + 1); if (d.getDay() % 6) list.push(new Date(d)); }
      const mk = (txt: string, sub = '') => { const b = document.createElement('button'); b.type = 'button'; b.innerHTML = sub ? `<small>${sub}</small>${txt}` : txt; return b; };
      const set = (wrap: Element, b: HTMLElement) => { wrap.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); };
      list.forEach((dt) => {
        const b = mk(String(dt.getDate()), dt.toLocaleDateString('en-US', { weekday: 'short' }).toLowerCase());
        b.setAttribute('aria-pressed', 'false');
        b.setAttribute('aria-label', dt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }));
        b.onclick = () => { day = dt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }); set(days, b); slots.classList.add('on'); out.value = ''; pick.textContent = `${day}: now pick a time`; slots.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false')); };
        days.append(b);
      });
      times.forEach((t) => { const b = mk(t); b.setAttribute('aria-pressed', 'false'); b.onclick = () => { if (!day) return; set(slots, b); out.value = `${day}, ${t} ET`; pick.textContent = `✓ ${out.value}. I'll confirm by email.`; }; slots.append(b); });
    }
  </script>
</body>
</html>

<style is:global>
  @font-face{font-family:'EB Garamond';font-weight:500;font-display:swap;src:url(/fonts/eb-garamond-latin-500-normal.woff2) format('woff2')}
  @font-face{font-family:'EB Garamond';font-weight:600;font-display:swap;src:url(/fonts/eb-garamond-latin-600-normal.woff2) format('woff2')}
  @font-face{font-family:'EB Garamond';font-weight:700;font-display:swap;src:url(/fonts/eb-garamond-latin-700-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:400;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-400-normal.woff2) format('woff2')}
  @font-face{font-family:'IBM Plex Mono';font-weight:600;font-display:swap;src:url(/fonts/ibm-plex-mono-latin-600-normal.woff2) format('woff2')}
  :root{--g:#588158;--g-d:#3f633f;--ink:#111;--paper:#fff;--grey:#d9d9d9;--serif:'EB Garamond',Georgia,serif;--mono:'IBM Plex Mono',ui-monospace,monospace}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--mono);font-size:17px;line-height:1.5}
  a{color:inherit}
  img{display:block;max-width:100%}
  h1,h2,h3{font-family:var(--serif);font-weight:600;letter-spacing:-.02em;line-height:1;margin:0}
  .skip{position:absolute;left:-9999px}.skip:focus{left:16px;top:16px;background:#fff;padding:8px 12px;z-index:9}
  .dots{background-color:var(--g);background-image:radial-gradient(rgba(0,0,0,.09) 2.2px,transparent 2.6px);background-size:22px 22px}
  .hero{min-height:100svh;display:flex;flex-direction:column;padding:clamp(24px,3.5vw,48px) clamp(24px,5vw,72px) 0;border-bottom:4px solid var(--ink);overflow:hidden}
  .nav{display:flex;justify-content:space-between;align-items:center}
  .mark{display:flex;align-items:center;gap:12px;font-family:var(--serif);font-weight:600;font-size:24px;text-decoration:none;letter-spacing:-.01em;color:var(--g-d)}.mark img{width:46px;height:auto}
  .nav span{display:flex;gap:22px}.nav span a{text-decoration:none;font-size:18px}.nav span a:hover{text-decoration:underline;text-underline-offset:5px}
  .hero h1{font-size:clamp(60px,10.5vw,170px);line-height:.92;letter-spacing:-.035em;margin:clamp(28px,6vh,72px) 0 0}
  .hero h1 .dot{color:var(--g)}
  .banner{margin:auto calc(clamp(24px,5vw,72px) * -1) 0;line-height:0}
  .banner svg{display:block;width:100%;height:auto}
  .banner .rays{transform-box:view-box;transform-origin:330px 150px;animation:spin 90s linear infinite}
  .banner .beam{transform-box:view-box;transform-origin:760px 129px;animation:sweep 7s ease-in-out infinite alternate}
  .banner .tw{transform-box:fill-box;transform-origin:center;animation:twinkle 3.2s ease-in-out infinite;animation-delay:var(--d)}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes sweep{from{transform:rotate(-7deg);opacity:.05}to{transform:rotate(9deg);opacity:.11}}
  @keyframes twinkle{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.45);opacity:.35}}
  .clock{font-size:14px;color:var(--g-d);margin-right:6px;font-variant-numeric:tabular-nums}
  .hl{display:flex;flex-direction:column}
  .hl .ln{display:block;overflow:hidden;padding-bottom:.08em;margin-bottom:-.08em}
  .hl .ln>span{display:block;transform:translateY(105%);animation:lnup 1.1s cubic-bezier(.16,1,.3,1) forwards}
  .hl .ln:nth-child(2)>span{animation-delay:.14s}
  @keyframes lnup{to{transform:none}}
  .mq{background:var(--g-d);color:#fff;overflow:hidden;border-bottom:4px solid var(--ink);padding:18px 0}
  .mqt{display:flex;width:max-content;gap:28px;align-items:center;animation:mq 38s linear infinite;font-family:var(--serif);font-size:clamp(28px,3.4vw,52px);font-style:italic}
  .mqt i{font-style:normal;font-size:.55em;color:#cfe3c9}
  @keyframes mq{to{transform:translateX(-50%)}}
  .lead.hi span{color:rgba(255,255,255,.28);transition:color .4s}
  .lead.hi span.on{color:#fff}
  .clients{margin:40px 0 0;font-size:15px;max-width:70ch}.clients span{display:inline-block;background:var(--g);color:#fff;border-radius:999px;padding:2px 12px;margin-right:10px;font-size:13px}.clients i{font-family:var(--serif);font-size:18px}
  .idea{background:var(--ink);color:#fff;padding:clamp(80px,12vw,180px) clamp(24px,5vw,72px);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:40px}
  .idea h2{font-size:clamp(64px,11vw,190px);letter-spacing:-.04em}.idea em{color:#9cc49a;font-style:italic}
  .mag{display:grid;place-items:center;width:clamp(160px,16vw,220px);aspect-ratio:1;border-radius:50%;background:var(--g);color:#fff;text-decoration:none;font-family:var(--serif);font-size:22px;font-weight:600;transition:transform .35s cubic-bezier(.2,.7,.2,1),background .25s}
  .mag:hover{background:#6e9a6d}
  .rise{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1);transition-delay:calc(var(--i,0) * 90ms)}
  .rise.in{opacity:1;transform:none}
  .about-sec{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(32px,6vw,96px);padding:clamp(64px,9vw,140px) clamp(24px,5vw,72px);color:#fff;border-bottom:4px solid var(--ink)}
  .about-sec h2{font-size:clamp(48px,6vw,96px);margin-bottom:28px}
  .lead{font-size:clamp(20px,2vw,28px);line-height:1.4;max-width:28ch;margin:0}
  .about-sec .me{width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:24px;border:3px solid #fff}
  .bio{max-width:40ch;margin:0 0 28px}
  .svc{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}
  .svc li{border:1.5px solid #fff;border-radius:999px;padding:4px 14px;font-size:14px}
  .work{position:relative;background:var(--paper);color:var(--ink);padding:clamp(56px,8vw,112px) clamp(24px,5vw,72px) clamp(80px,10vw,140px);border-bottom:4px solid var(--ink)}
  .work h2{font-size:clamp(48px,6vw,96px);margin-bottom:20px}
  .work .sub{font-size:clamp(17px,1.6vw,22px);max-width:62ch;margin:0 0 48px}
  .plist{list-style:none;margin:0;padding:0;border-top:1.5px solid var(--ink)}
  .prow{border-bottom:1.5px solid var(--ink)}
  .prow a{display:grid;grid-template-columns:56px 1fr auto 40px;align-items:baseline;gap:20px;padding:clamp(18px,2.6vw,34px) 0;text-decoration:none;transition:padding .35s cubic-bezier(.2,.7,.2,1),color .25s}
  .num{font-size:14px;color:var(--g-d)}
  .pname{font-family:var(--serif);font-weight:500;font-size:clamp(34px,5.4vw,84px);line-height:1;letter-spacing:-.03em}
  .ptag{font-size:14px;text-align:right}
  .arrow{font-size:28px;transition:transform .35s}
  .prow a:hover,.prow a:focus-visible{padding-left:18px;color:var(--g-d)}
  .prow a:hover .arrow,.prow a:focus-visible .arrow{transform:translate(4px,-4px) rotate(0)}
  .ptext{display:none;margin:-8px 0 22px 76px;max-width:56ch}
  .peek{position:absolute;left:0;top:0;width:300px;pointer-events:none;opacity:0;scale:.85;transition:opacity .25s,scale .3s cubic-bezier(.2,.7,.2,1);z-index:3}
  .peek.on{opacity:1;scale:1}
  .pv{display:none;background:var(--g);color:#fff;border-radius:16px;padding:22px;box-shadow:0 18px 40px rgba(0,0,0,.18);rotate:-2deg}
  .pv b{font-family:var(--serif);font-size:22px;display:block;margin-bottom:8px}.pv p{margin:0 0 14px;font-size:15px}.pv span{font-size:13px;opacity:.85}
  .peek[data-i="0"] .pv:nth-child(1),.peek[data-i="1"] .pv:nth-child(2),.peek[data-i="2"] .pv:nth-child(3){display:block}
  @media (hover:none),(pointer:coarse){.ptext{display:block}.peek{display:none}}
  .contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,96px);padding:clamp(64px,9vw,140px) clamp(24px,7vw,116px)}
  .form{background:var(--g);color:#fff;border-radius:28px;padding:clamp(24px,3.5vw,48px);display:flex;flex-direction:column;gap:18px;box-shadow:0 30px 60px -30px rgba(31,58,31,.6);position:relative;overflow:hidden}
  .form::before{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,#f5d97a 0 30%,transparent 31%),radial-gradient(circle,rgba(255,255,255,.12),transparent 70%);opacity:.9;pointer-events:none}
  .form h2{font-size:clamp(48px,5vw,76px);color:#fff}.form h2 em{color:#f5d97a}
  .fsub{margin:-6px 0 6px;color:#e3eedf;max-width:40ch}
  .form .two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .fl{position:relative;display:block}
  .fl input,.fl textarea{width:100%;font:inherit;font-size:17px;color:#fff;background:rgba(255,255,255,.08);border:0;border-bottom:2px solid rgba(255,255,255,.55);border-radius:12px 12px 0 0;padding:26px 14px 10px;transition:background .25s,border-color .25s}
  .fl textarea{resize:vertical}
  .fl span{position:absolute;left:14px;top:18px;font-size:16px;color:#d6e6d2;pointer-events:none;transition:all .2s}
  .fl input:focus,.fl textarea:focus{outline:none;background:rgba(255,255,255,.16);border-color:#f5d97a}
  .fl input:focus+span,.fl input:not(:placeholder-shown)+span,.fl textarea:focus+span,.fl textarea:not(:placeholder-shown)+span{top:6px;font-size:12px;color:#f5d97a;letter-spacing:.06em}
  .chips,.cal{border:0;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}
  .chips legend,.cal legend{font-size:13px;letter-spacing:.08em;color:#e3eedf;margin-bottom:10px;padding:0}.cal legend i{font-style:normal;opacity:.7}
